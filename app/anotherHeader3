"use client";

import React, { useState } from "react";
import {
  ShoppingCart,
  Search,
  Layers,
  Heart,
  Store,
  Menu,
  X,
} from "lucide-react";
import Link from "next/link";
import Image from "next/image";
import { usePathname, useRouter } from "next/navigation";
import { useShop } from "@/app/context/ShopContext";

export default function Header() {
  const [searchQuery, setSearchQuery] = useState("");
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [catMenuOpen, setCatMenuOpen] = useState(false);
  const [activeCategoryIdx, setActiveCategoryIdx] = useState(0);

  const pathname = usePathname();
  const router = useRouter();

  const { cartItems, wishlist, products, categories } = useShop();

  const filteredProducts =
    searchQuery.trim() === ""
      ? []
      : products.filter((p) =>
          p.name.toLowerCase().includes(searchQuery.toLowerCase())
        );

  const handleSearchClick = (id) => {
    setSearchQuery("");
    setMobileMenuOpen(false);
    router.push(`/product/${id}`);
  };

  const getLinkClass = (path) =>
    pathname === path
      ? "text-[#e11d48] font-medium"
      : "text-gray-700 hover:text-[#e11d48]";

  return (
    <header className="border-b bg-white sticky top-0 z-50">

      {/* TOP HEADER */}
      <div className="container max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">

        {/* LOGO */}
        <Link href="/" className="flex-shrink-0">
          <Image
            src="/logo.png"
            alt="Logo"
            width={130}
            height={50}
            className="object-contain"
            priority
          />
        </Link>

        {/* DESKTOP SEARCH */}
        <div className="hidden md:block flex-1 max-w-lg mx-6 relative">
          <div className="flex items-center w-full border border-gray-300 rounded-lg overflow-hidden">
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Search…"
              className="flex-1 px-4 py-2 text-sm outline-none"
            />
            <button className="px-3">
              <Search className="w-5 h-5 text-gray-700" />
            </button>
          </div>

          {filteredProducts.length > 0 && (
            <div className="absolute left-0 right-0 top-12 bg-white border rounded-lg shadow-lg max-h-80 overflow-y-auto z-50">
              {filteredProducts.map((product) => (
                <div
                  key={product._id}
                  onClick={() => handleSearchClick(product._id)}
                  className="flex items-center gap-3 px-4 py-2 hover:bg-gray-100 cursor-pointer"
                >
                  {product.imagesUrl?.[0] && (
                    <Image
                      src={product.imagesUrl[0]}
                      width={40}
                      height={40}
                      alt={product.name}
                      className="rounded object-cover"
                    />
                  )}
                  <div>
                    <p className="text-sm font-medium">{product.name}</p>
                    <p className="text-xs text-gray-500">₹{product.price}</p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* DESKTOP ICONS */}
        <div className="hidden md:flex items-center gap-6">

          <Link href="/store" className={getLinkClass("/store")}>
            <Store className="w-5 h-5 inline-block mr-1" />
            Stores
          </Link>

          <Link href="/wishlist" className="relative">
            <Heart className="w-5 h-5 text-gray-700 hover:text-[#e11d48]" />
            {wishlist.length > 0 && (
              <span className="absolute -top-2 -right-2 bg-[#e11d48] text-white text-xs font-semibold rounded-full w-5 h-5 flex items-center justify-center">
                {wishlist.length}
              </span>
            )}
          </Link>

          <Link href="/cart" className="relative">
            <ShoppingCart className="w-5 h-5 text-gray-700 hover:text-[#e11d48]" />
            {cartItems.length > 0 && (
              <span className="absolute -top-2 -right-2 bg-[#e11d48] text-white text-xs font-semibold rounded-full w-5 h-5 flex items-center justify-center">
                {cartItems.length}
              </span>
            )}
          </Link>
        </div>

        {/* MOBILE MENU BUTTON */}
        <button
          className="md:hidden"
          onClick={() => setMobileMenuOpen(true)}
        >
          <Menu className="w-7 h-7 text-gray-800" />
        </button>
      </div>

      {/* ================ MOBILE SLIDE MENU ================= */}
      <div
        className={`fixed top-0 right-0 h-screen w-full bg-white shadow-xl z-[999] transform transition-transform duration-300 ${
          mobileMenuOpen ? "translate-x-0" : "translate-x-full"
        }`}
      >
        {/* CLOSE BUTTON */}
        <div className="flex justify-between items-center p-5 border-b">
          <h2 className="text-lg font-semibold">Search</h2>
          <button onClick={() => setMobileMenuOpen(false)}>
            <X className="w-6 h-6 text-gray-700" />
          </button>
        </div>

        {/* SEARCH BAR */}
        <div className="p-4">
          <div className="flex items-center w-full border border-gray-300 rounded-lg overflow-hidden">
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Search products..."
              className="flex-1 px-4 py-3 text-base outline-none"
            />
            <button className="px-3">
              <Search className="w-6 h-6 text-gray-700" />
            </button>
          </div>

          {/* SEARCH RESULTS */}
          {filteredProducts.length > 0 && (
            <div className="mt-4 bg-white border rounded-lg shadow-md max-h-96 overflow-y-auto">
              {filteredProducts.map((product) => (
                <div
                  key={product._id}
                  onClick={() => handleSearchClick(product._id)}
                  className="flex items-center gap-3 px-4 py-3 hover:bg-gray-100 cursor-pointer"
                >
                  {/* <Image
                    src={product?.imageUrl?.[0]}
                    width={50}
                    height={50}
                    alt={product.name}
                    className="rounded object-cover"
                  /> */}
                  <div>
                    <p className="font-medium">{product.name}</p>
                    <p className="text-sm text-gray-600">₹{product.price}</p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* MOBILE LINKS */}
        <div className="p-4 border-t space-y-5">
          <Link href="/store" className="flex items-center gap-3 text-gray-700 text-lg">
            <Store /> Stores
          </Link>

          <Link href="/wishlist" className="flex items-center gap-3 text-gray-700 text-lg">
            <Heart /> Wishlist
          </Link>

          <Link href="/cart" className="flex items-center gap-3 text-gray-700 text-lg">
            <ShoppingCart /> Cart
          </Link>
        </div>
      </div>
    </header>
  );
}
